{
  "name": "nirikshak-backend",
  "version": "1.0.0",
  "description": "NIRIKSHAK Backend API & AI Analysis Service",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx tests/security-suite.ts && tsx tests/ai-gateway.test.ts && tsx tests/zero-trust-blockchain.test.ts",
    "test:security": "tsx tests/security-suite.ts",
    "test:ai": "tsx tests/ai-gateway.test.ts",
    "test:blockchain": "tsx tests/zero-trust-blockchain.test.ts",
    "worker:blockchain:dev": "tsx watch src/workers/blockchainWorker.entry.ts",
    "worker:blockchain": "node dist/workers/blockchainWorker.entry.js",
    "seed:test-users": "tsx scripts/seed-test-users.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@hyperledger/fabric-gateway": "^1.12.1",
    "@supabase/supabase-js": "^2.49.1",
    "@types/pg": "^8.23.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
