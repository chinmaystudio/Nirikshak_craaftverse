# NIRIKSHAK Backend Environment Configuration
PORT=4000
NODE_ENV=development

# Supabase Project Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Microservice Gateway (Server-Side Only)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_SHARED_SECRET=your-shared-secret-here
AI_SERVICE_TIMEOUT_MS=20000

# OpenRouter / LLM Engine (Delegated to Python AI microservice)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-4-340b-instruct

# Security & CORS (Comma-separated origins in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
