{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "types": ["vite/client"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*",
        "src/modules/government/*",
        "src/modules/user/*",
        "src/modules/contractor/*"
      ],
      "@gov/*": ["src/modules/government/*"],
      "@con/*": ["src/modules/contractor/*"],
      "@usr/*": ["src/modules/user/*"]
    }
  },
  "include": ["src"]
}
